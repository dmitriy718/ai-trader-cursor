# =============================================================================
# DOCKER
# =============================================================================

# Docker volumes and data
docker-data/
.dockerignore

# Docker Compose override files
docker-compose.override.yml
docker-compose.*.yml
!docker-compose.yml

# =============================================================================
# TEMPORARY & CACHE FILES
# =============================================================================

# Temporary files
*.tmp
*.temp
*.bak
*.backup
*.old
*.orig
*.save
*.swp
*.swo
*~

# Cache directories
.cache/
*.cache
.pytest_cache/
.mypy_cache/
.ruff_cache/

# =============================================================================
# TRADING BOT SPECIFIC
# =============================================================================

# Trading data and backups
data/
backups/
*.backup
*.bak

# Test data
test_data/
test_output/
*.test.db

# Performance profiling
*.prof
*.pstats
profile_results/

# Stress test outputs
stress_test_*.log
stress_test_*.json
stress_test_results/

# =============================================================================
# SECURITY & COMPLIANCE
# =============================================================================

# Private keys
*.pem
*.key
*.crt
*.cert
*.p12
*.pfx
id_rsa
id_rsa.pub
id_dsa
id_dsa.pub
*.gpg
*.asc

# Security scan results
security-report.txt
vulnerability-report.*
*.security

# =============================================================================
# MISC
# =============================================================================

# Archives
*.zip
*.tar
*.tar.gz
*.tgz
*.rar
*.7z

# Compiled binaries
*.exe
*.dll
*.dylib

# Node modules (if any frontend tools)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# =============================================================================
# KEEP THESE (Important files that should be tracked)
# =============================================================================

# Keep example files
!.env.example
!config/config.yaml.example
!*.example

# Keep documentation
!README.md
!*.md

# Keep requirements
!requirements.txt
!requirements-dev.txt

# Keep Docker files
!Dockerfile
!docker-compose.yml
!.dockerignore

# Keep CI/CD configs
!.github/
!.gitlab-ci.yml
!.travis.yml

# Keep test configs
!pytest.ini
!tox.ini
!.coveragerc

# Keep empty directories with .gitkeep
!.gitkeep
